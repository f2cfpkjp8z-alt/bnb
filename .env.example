# Copy this file to ".env" and fill in only what you need. Never share or commit ".env".

# The simulation account needs NO keys at all (it uses public Binance market data).

# ---- Web app (Firebase). See FIREBASE_SETUP.md ------------------------------------
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json
FIREBASE_OWNER_UID=

# ---- Optional: real money account (python bot.py --live ...) ----------------------
# Create the key with "Enable Spot & Margin Trading" ONLY. Withdrawals OFF.
# Restrict it to your own IP address.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Optional: Binance testnet (python bot.py --testnet) --------------------------
# Free fake-money keys from https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ---- Optional: news filter (free key from https://aistudio.google.com/apikey) -----
GEMINI_API_KEY=
